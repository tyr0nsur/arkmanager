{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "baseUrl": ".",
    "paths": {
      "@shared/*": [
        "../shared/*"
      ],
      "@/*": [
        "./src/*"
      ],
      "@core/*": [
